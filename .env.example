# Do not commit real secrets. Copy this to .env.local for local testing or configure these in the hosting platform.

ADMIN_PASSCODE=
ADMIN_AUTH_SECRET=

# RBAC staff login (Admin > Access Control seeds named users; sessions are
# server-side and revocable). No extra env needed for local JSON storage.
# Optional: point the rate limiter at self-hosted Redis later (adapter in
# lib/access/rate-limit.ts); in-memory limiting is used until then.
# REDIS_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
RECEPTION_USERNAME=
RECEPTION_PASSWORD=
STAFF_USERS_JSON=
DOCTOR_PASSCODE=
MOBILE_API_TOKEN=

DATABASE_URL=
DATABASE_SSL=
DATABASE_POOL_MAX=
DATA_SOURCE=local-json
BACKUP_POLICY=
BACKUP_POLICY_URL=
MONITORING_DSN=
SENTRY_DSN=

# Powers appointment-confirmation emails and patient-portal magic-link login
# (lib/email.ts). Any SMTP server works — a nodemailer connection string:
#   smtps://<mailbox>:<password>@<host>:465
# Percent-encode any @ or : inside the password. Until this is set, sends are
# logged instead of attempted so dev/staging stays usable without credentials.
SMTP_URL=
# MSG91 auth key for patient-portal OTP SMS (the approved paid exception,
# patient-facing only). Until both values are set, dev builds surface the OTP
# on screen and production refuses SMS login.
SMS_PROVIDER_KEY=
MSG91_TEMPLATE_ID=
WHATSAPP_PROVIDER_KEY=

# Enables AI patient summary generation in the Doctor workspace (Claude API).
ANTHROPIC_API_KEY=

# Optional: explicit Chromium/Chrome binary path for the Discharge Summary PDF renderer.
# Auto-detected on local dev (system Chrome) and on Vercel/Lambda/Netlify (@sparticuz/chromium).
# Only set this for a custom deployment target where auto-detection does not apply.
PDF_CHROMIUM_EXECUTABLE_PATH=

PRIVACY_REVIEWED_AT=
